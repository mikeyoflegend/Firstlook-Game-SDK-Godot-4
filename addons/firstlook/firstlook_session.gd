class_name FirstLookSession
extends RefCounted

## Session lifecycle. FirstLook session IDs are generated by the game and
## reported with session_start / session_end events.
## Endpoint: POST /client/v0/analytics
##
## Sessions that never end (for example after a crash) are left out of
## FirstLook's average and percentile metrics, so ending cleanly matters.

var _http: FirstLookHttp
var _config: FirstLookConfig
var _session_id: String = ""
var is_active: bool = false

func _init(http: FirstLookHttp, config: FirstLookConfig) -> void:
	_http = http
	_config = config

## Returns { success, session_id, error }
func start_session() -> Dictionary:
	if is_active:
		return { "success": true, "session_id": _session_id, "error": "" }

	var new_id := FirstLookHttp.uuid_v4()
	var result := await _http.post("/client/v0/analytics", _body(new_id, "session_start"))
	if not result.success:
		return { "success": false, "session_id": "", "error": "Session start failed: " + result.error }

	_session_id = new_id
	is_active = true
	return { "success": true, "session_id": _session_id, "error": "" }

## Returns { success, error }
func end_session() -> Dictionary:
	if not is_active:
		return { "success": false, "error": "No active session to end." }

	# Mark inactive first so a second quit signal does not double-send.
	is_active = false
	var ended_id := _session_id
	var result := await _http.post("/client/v0/analytics", _body(ended_id, "session_end"))
	_session_id = ""
	if not result.success:
		return { "success": false, "error": "Session end failed: " + result.error }
	return { "success": true, "error": "" }

func get_session_id() -> String:
	return _session_id

func _body(id: String, event_type: String) -> Dictionary:
	var body := {
		"session_id": id,
		"event_type": event_type,
		"timestamp": FirstLookHttp.timestamp(),
	}
	var build := resolve_build_version(_config)
	if build != "":
		body["build_version"] = build
	return body

static func resolve_build_version(config: FirstLookConfig) -> String:
	if config.build_version != "":
		return config.build_version
	return str(ProjectSettings.get_setting("application/config/version", ""))
